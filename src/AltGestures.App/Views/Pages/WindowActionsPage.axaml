<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AltGestures.Core.Windowing"
             xmlns:vm="using:AltGestures.App.ViewModels.Pages"
             x:DataType="vm:WindowActionsPageViewModel"
             x:Class="AltGestures.App.Views.Pages.WindowActionsPage">
  <StackPanel Spacing="16">
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="group-title" Text="鼠标键分配" />
        <UniformGrid Columns="2" Rows="3">
          <StackPanel Margin="0,0,18,14" Spacing="7">
            <TextBlock Classes="body" Text="左键" />
            <ComboBox Classes="app-input"
                      ItemsSource="{Binding ActionOptions, Mode=OneWay}"
                      SelectedItem="{Binding LeftAction, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:WindowAction">
                  <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Classes="body" Text="中键" />
            <ComboBox Classes="app-input"
                      ItemsSource="{Binding ActionOptions, Mode=OneWay}"
                      SelectedItem="{Binding MiddleAction, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:WindowAction">
                  <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,18,14" Spacing="7">
            <TextBlock Classes="body" Text="右键" />
            <ComboBox Classes="app-input"
                      ItemsSource="{Binding ActionOptions, Mode=OneWay}"
                      SelectedItem="{Binding RightAction, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:WindowAction">
                  <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Classes="body" Text="滚轮" />
            <ComboBox Classes="app-input"
                      ItemsSource="{Binding ActionOptions, Mode=OneWay}"
                      SelectedItem="{Binding WheelAction, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:WindowAction">
                  <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Classes="body" Text="侧键 4（X1）" />
            <ComboBox Classes="app-input"
                      ItemsSource="{Binding ActionOptions, Mode=OneWay}"
                      SelectedItem="{Binding XButton1Action, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:WindowAction">
                  <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Classes="body" Text="侧键 5（X2）" />
            <ComboBox Classes="app-input"
                      ItemsSource="{Binding ActionOptions, Mode=OneWay}"
                      SelectedItem="{Binding XButton2Action, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:WindowAction">
                  <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </UniformGrid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="group-title" Text="拖拽行为" />
        <StackPanel Spacing="8">
          <CheckBox Content="拖动窗口时自动聚焦" IsChecked="{Binding AutoFocus, Mode=TwoWay}" />
          <CheckBox Content="中键点击标题栏时将窗口下沉" />
          <CheckBox Content="模拟 Windows Aero 吸附" IsChecked="{Binding Aero, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="body" Text="吸附距离" />
            <NumericUpDown Classes="app-input" Value="{Binding SnapThreshold, Mode=TwoWay}" Minimum="1" />
            <TextBlock Classes="muted" Text="像素" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="body" Text="移动节流" />
            <NumericUpDown Classes="app-input" Value="{Binding MoveRate, Mode=TwoWay}" Minimum="1" />
            <TextBlock Classes="muted" Text="像素" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="body" Text="缩放节流" />
            <NumericUpDown Classes="app-input" Value="{Binding ResizeRate, Mode=TwoWay}" Minimum="1" />
            <TextBlock Classes="muted" Text="像素" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="group-title" Text="修饰键" />
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Classes="body" Text="Shift" />
          <TextBlock Grid.Column="1" Classes="secondary" Text="吸附到其他窗口（自动吸附关闭时的手动吸附）" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Classes="body" Text="Ctrl" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="secondary" Text="把正在拖拽的窗口提到前台" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Classes="body" Text="空格" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="secondary" Text="临时关闭自动吸附" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
